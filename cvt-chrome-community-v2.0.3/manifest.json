{
  "manifest_version": 3,
  "name": "Civitai Bulk React + Save",
  "version": "2.0.3",
  "description": "Bulk reactions and save to collections for Civitai images",
  "permissions": [
    "storage",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://civitai.red/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Civitai Bulk Tools"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://civitai.red/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}